{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-owner-toolkit.dev/prototype-playground/design-notes.schema.json",
  "title": "Design notes companion (companions/design-notes.json)",
  "description": "Verbatim, anchored PRD passages quoted next to a prototype. Sections must resolve against the source PRD's numbered headings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section", "label", "quote", "requirementIds"],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "section": { "$ref": "#/$defs/prdSection" },
          "label": { "$ref": "#/$defs/label" },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/requirementId" }
          }
        }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
    },
    "prdSection": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
      "minLength": 1,
      "maxLength": 16
    },
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\s]+$"
    }
  }
}
