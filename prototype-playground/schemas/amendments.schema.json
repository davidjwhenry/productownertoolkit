{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-owner-toolkit.dev/prototype-playground/amendments.schema.json",
  "title": "Amendments (prototypes/<prototype-id>/amendments.json)",
  "description": "Writeable review state pinned to a screen and requirement. Screen IDs must exist in a declared variant; requirement IDs must be declared by the manifest or its scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "amendments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "amendments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "screenId", "requirementId", "title", "note", "selection", "author", "date", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "screenId": { "$ref": "#/$defs/kebabId" },
          "requirementId": {
            "oneOf": [{ "$ref": "#/$defs/requirementId" }, { "type": "null" }]
          },
          "title": { "$ref": "#/$defs/label" },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variantId", "surfaceId", "scenarioId", "themeId", "screenId"],
            "properties": {
              "variantId": { "$ref": "#/$defs/kebabId" },
              "surfaceId": { "enum": ["desktop", "ios"] },
              "scenarioId": { "$ref": "#/$defs/kebabId" },
              "themeId": { "$ref": "#/$defs/kebabId" },
              "screenId": { "$ref": "#/$defs/kebabId" }
            }
          },
          "author": { "$ref": "#/$defs/label" },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status": { "enum": ["open", "resolved", "dismissed"] }
        }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
    },
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\s]+$"
    }
  }
}
