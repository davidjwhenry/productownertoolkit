{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-owner-toolkit.dev/prototype-playground/prototype.schema.json",
  "title": "Prototype manifest (prototypes/<prototype-id>/prototype.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "revision",
    "source",
    "designSystem",
    "brief",
    "variants",
    "surfaces",
    "scenarios",
    "defaults",
    "prototypeOnly"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/kebabId" },
    "title": { "$ref": "#/$defs/label" },
    "summary": { "$ref": "#/$defs/freeText" },
    "revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd", "requirementIds"],
      "properties": {
        "prd": { "$ref": "#/$defs/repoRelativePath" },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementId" }
        }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "version": { "type": "string", "pattern": "^v[0-9]{3}$" },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryUser", "job", "journey", "decision"],
      "properties": {
        "primaryUser": { "$ref": "#/$defs/freeText" },
        "job": { "$ref": "#/$defs/freeText" },
        "journey": { "$ref": "#/$defs/freeText" },
        "decision": { "$ref": "#/$defs/freeText" }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "hypothesis", "tradeOffs", "entry"],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "label": { "$ref": "#/$defs/label" },
          "hypothesis": { "$ref": "#/$defs/freeText" },
          "tradeOffs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/freeText" }
          },
          "entry": { "$ref": "#/$defs/repoRelativePath" }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "ios"] }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "requirementIds"],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "label": { "$ref": "#/$defs/label" },
          "description": { "$ref": "#/$defs/freeText" },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/requirementId" }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "surface", "scenario", "theme"],
      "properties": {
        "variant": { "$ref": "#/$defs/kebabId" },
        "surface": { "enum": ["desktop", "ios"] },
        "scenario": { "$ref": "#/$defs/kebabId" },
        "theme": { "$ref": "#/$defs/kebabId" }
      }
    },
    "prototypeOnly": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/freeText" }
    },
    "companions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "$ref": "#/$defs/kebabId" },
          "path": { "$ref": "#/$defs/repoRelativePath" }
        }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
    },
    "freeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
    },
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\s]+$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\\\][^\\u0000-\\u001F\\u007F\\\\]*$"
    }
  }
}
