{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-owner-toolkit.dev/prototype-playground/design-profile.schema.json",
  "title": "Design profile manifest (design-system/profiles/vNNN/profile.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "sources",
    "themes",
    "defaultTheme",
    "runtimeCss",
    "componentCatalogue",
    "assetCatalogue"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/kebabId" },
    "version": { "type": "string", "pattern": "^v[0-9]{3}$" },
    "name": { "$ref": "#/$defs/label" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/source" }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "label": { "$ref": "#/$defs/label" }
        }
      }
    },
    "defaultTheme": { "$ref": "#/$defs/kebabId" },
    "runtimeCss": { "$ref": "#/$defs/versionRelativePath" },
    "componentCatalogue": { "$ref": "#/$defs/versionRelativePath" },
    "assetCatalogue": { "$ref": "#/$defs/versionRelativePath" },
    "deviceChrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "ios"],
      "properties": {
        "desktop": { "$ref": "#/$defs/desktopChrome" },
        "ios": { "$ref": "#/$defs/iosChrome" }
      }
    },
    "layout": { "$ref": "#/$defs/profileLayout" },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/versionRelativePath" }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\\\][^\\u0000-\\u001F\\u007F\\\\]*$"
    },
    "versionRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\\\/][^\\u0000-\\u001F\\u007F\\\\]*$"
    },
    "hexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "roles", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "kind": { "enum": ["pen", "css", "dtcg", "markdown", "figma"] },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["tokens", "components", "assets", "guidance"] }
        },
        "required": { "type": "boolean" },
        "path": { "$ref": "#/$defs/repoRelativePath" },
        "sha256": { "$ref": "#/$defs/hexSha256" },
        "uri": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1024
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "figma" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["uri", "sourceKey"],
            "properties": { "uri": true, "sourceKey": true },
            "not": {
              "anyOf": [
                { "required": ["path"], "properties": { "path": true } },
                { "required": ["sha256"], "properties": { "sha256": true } }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "kind": { "const": "figma" } },
              "required": ["kind"]
            }
          },
          "then": {
            "required": ["path", "sha256"],
            "properties": { "path": true, "sha256": true },
            "not": {
              "anyOf": [
                { "required": ["uri"], "properties": { "uri": true } },
                { "required": ["sourceKey"], "properties": { "sourceKey": true } }
              ]
            }
          }
        }
      ]
    },
    "pxInt": { "type": "integer", "minimum": 0, "maximum": 2000 },
    "desktopChrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleBarHeight", "outerRadius"],
      "properties": {
        "titleBarHeight": { "$ref": "#/$defs/pxInt" },
        "outerRadius": { "$ref": "#/$defs/pxInt" }
      }
    },
    "iosChrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bezel", "outerRadius", "island", "homeIndicator", "safeArea"],
      "properties": {
        "bezel": { "$ref": "#/$defs/pxInt" },
        "outerRadius": { "$ref": "#/$defs/pxInt" },
        "island": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "$ref": "#/$defs/pxInt" },
            "height": { "$ref": "#/$defs/pxInt" }
          }
        },
        "homeIndicator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "$ref": "#/$defs/pxInt" },
            "height": { "$ref": "#/$defs/pxInt" }
          }
        },
        "safeArea": { "$ref": "#/$defs/safeArea" }
      }
    },
    "safeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "$ref": "#/$defs/pxInt" },
        "right": { "$ref": "#/$defs/pxInt" },
        "bottom": { "$ref": "#/$defs/pxInt" },
        "left": { "$ref": "#/$defs/pxInt" }
      }
    },
    "profileLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["railWidth", "flowWidth", "notesWidth", "stageMaxWidth"],
      "properties": {
        "railWidth": { "type": "integer", "minimum": 120, "maximum": 800 },
        "flowWidth": { "type": "integer", "minimum": 120, "maximum": 800 },
        "notesWidth": { "type": "integer", "minimum": 120, "maximum": 800 },
        "stageMaxWidth": { "type": "integer", "minimum": 320, "maximum": 1600 }
      }
    }
  }
}
